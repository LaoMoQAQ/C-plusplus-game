                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",

                
                "${workspaceFolder}\\FourYears\\main.cpp",



                "${workspaceFolder}\\FourYears\\core\\Game.cpp",
                "${workspaceFolder}\\FourYears\\core\\Renderer.cpp",
                "${workspaceFolder}\\FourYears\\core\\ResourceManager.cpp",
                "${workspaceFolder}\\FourYears\\core\\TextSystem.cpp",
                "${workspaceFolder}\\FourYears\\core\\ScriptPlayer.cpp",
                "${workspaceFolder}\\FourYears\\core\\SaveSystem.cpp",
                "${workspaceFolder}\\FourYears\\core\\AudioManager.cpp",
                "${workspaceFolder}\\FourYears\\core\\FontManager.cpp",
                "${workspaceFolder}\\FourYears\\core\\Config.cpp",
                "${workspaceFolder}\\FourYears\\core\\Utils.cpp",



                "${workspaceFolder}\\FourYears\\story\\Character.cpp",
                "${workspaceFolder}\\FourYears\\story\\History.cpp",
                "${workspaceFolder}\\FourYears\\story\\RouteManager.cpp",
                "${workspaceFolder}\\FourYears\\story\\Story.cpp",
                "${workspaceFolder}\\FourYears\\story\\StoryParser.cpp",



                "${workspaceFolder}\\FourYears\\ui\\UIManager.cpp",

{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Build FourYears",

            "type": "process",

            "command": "C:/msys64/usr/bin/make.exe",

            "args": [
                "-C",
                "F:/gal"
            ],

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "problemMatcher": [
                "$gcc"
            ]
        },

        {
            "label": "Run FourYears",

            "type": "process",

            "command": "F:/gal/FourYears/game.exe",

            "args": [],

            "group": {
                "kind": "test"
            },

            "problemMatcher": []
        },

        {
            "label": "Clean FourYears",

            "type": "process",

            "command": "C:/msys64/usr/bin/make.exe",

            "args": [
                "-C",
                "F:/gal",
                "clean"
            ],

            "group": "none",

            "problemMatcher": []
        }
    ]
}
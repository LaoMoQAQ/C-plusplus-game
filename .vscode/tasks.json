{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Build FourYears",

            "type": "process",

            "command": "C:/msys64/usr/bin/bash.exe",

            "args": [
                "-c",
                "source /etc/profile && rm -f /f/gal/FourYears/game.exe && make -C /f/gal > /tmp/make_vscode.log 2>&1"
            ],

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "problemMatcher": [
                "$gcc"
            ],

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },

        {
            "label": "Run FourYears",

            "type": "process",

            "command": "C:/msys64/usr/bin/bash.exe",

            "args": [
                "-c",
                "cd /f/gal/FourYears && ./game.exe"
            ],

            "group": {
                "kind": "test"
            },

            "problemMatcher": [],

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },

        {
            "label": "Clean FourYears",

            "type": "process",

            "command": "C:/msys64/usr/bin/bash.exe",

            "args": [
                "-c",
                "source /etc/profile && make -C /f/gal clean"
            ],

            "group": "none",

            "problemMatcher": [],

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}